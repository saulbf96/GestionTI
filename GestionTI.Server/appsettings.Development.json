{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "Groups": {
      // SOLO DESARROLLO: S-1-5-11 = "Usuarios autenticados". En tu máquina, cualquier cuenta
      // del dominio entra como Admin mientras no existan los grupos GG_GestionTI_*.
      // Para probar otro rol: pon "S-1-5-11" en "Technician" o "ReadOnly" y aquí un grupo
      // al que no pertenezcas (por ejemplo "S-1-0-0"). Los arreglos se combinan por posición.
      "Admin": [ "S-1-5-11" ]
    }
  }
}
